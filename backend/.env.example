# Backend Environment Variables — NEVER commit .env to git!
# Copy this file to .env and fill in your real values.

DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# Get these from: https://app.supabase.com -> Project -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# Add your Vercel frontend URL (JSON array)
ALLOWED_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]
